[Unit]
Description=Portfolio Tracker Flask API
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/portfolio-tracker/backend
ExecStart=/home/ubuntu/portfolio-tracker/backend/venv/bin/gunicorn \
    --workers 1 --threads 4 --timeout 120 \
    --max-requests 1000 --max-requests-jitter 100 \
    --bind 127.0.0.1:5001 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
